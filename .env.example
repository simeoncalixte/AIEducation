POSTGRES_USER=evolvingclass
POSTGRES_PASSWORD=evolvingclass
POSTGRES_DB=evolvingclass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: fully explicit URL, takes precedence over the POSTGRES_* parts.
# DATABASE_URL=postgresql+psycopg://evolvingclass:evolvingclass@localhost:5432/evolvingclass
