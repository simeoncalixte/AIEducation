# EvolvingClass generation API service.
# Same dev-parity pattern as the web Dockerfile: source on PYTHONPATH,
# third-party floors from the pipeline manifest.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/database:/app/pipeline:/app/service \
    PORT=5002 \
    HOST=0.0.0.0 \
    CONTENT_ROOT=/var/lib/generation/content \
    PREVIEW_ROOT=/var/lib/generation/previews

WORKDIR /app

RUN pip install --no-cache-dir \
    "sqlalchemy>=2.0" \
    "alembic>=1.13" \
    "psycopg[binary]>=3.1" \
    "python-dotenv>=1.0" \
    "flask>=3.0"

COPY database/ ./database/
COPY pipeline/ ./pipeline/
COPY service/ ./service/

VOLUME /var/lib/generation

EXPOSE 5002

CMD ["python", "-m", "evolvingclass_pipeline.app"]
